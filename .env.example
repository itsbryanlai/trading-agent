# Admin credential for the shared Postgres database. Used ONLY by the migration
# step (`python -m trading_agent.storage.migrate`), run at deploy time. Never
# give this to a component: every component connects as its own restricted
# role (specs/001-data-model/contracts/role-grants.md).
# Export it in your shell; never write the real value into any file in this repo.
ADMIN_DATABASE_URL=

# A disposable database for the integration test suite. The suite creates
# cluster-wide `ta_*` roles and throwaway databases, so this must NEVER point at
# the Railway database. Its user must be a superuser (the Docker `postgres`
# user is), because the tests switch into each `ta_*` role with SET ROLE.
TEST_DATABASE_URL=

# --- Execution (specs/003-execution) ---------------------------------------
# The Alpaca PAPER account's keys. Given to Execution only, never to any other
# component (Constitution I, III). Export them in the Execution process's
# environment; never write the real values into any file in this repo.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Optional. If set, it must equal https://paper-api.alpaca.markets exactly or
# Execution refuses to start. The paper address is fixed in code regardless.
ALPACA_BASE_URL=
# A login in the ta_execution role.
EXECUTION_DATABASE_URL=

# --- Risk Gate trigger runner (python -m trading_agent.risk, ADR 0013) -----
# A login in the ta_risk_gate role. Used only by the gate's own process to
# evaluate stop-loss triggers; never given to Execution's process.
RISK_GATE_DATABASE_URL=

# --- Reference-data job (specs/004-reference-data) --------------------------
# A read-only Finnhub key, for this job only. It cannot trade. If it shares a
# Finnhub account with Research later, the two share that account's rate limit
# (research D13); keep config/reference_data.yaml's calls_per_minute below it.
# Export it in the job's environment; never write the real value into any file.
REFERENCE_DATA_FINNHUB_API_KEY=
# A login in the ta_reference_data role.
REFERENCE_DATA_DATABASE_URL=

# --- Orchestrator (specs/005-orchestrator, ADR 0015) -------------------------
# A login in the ta_orchestrator role: the orchestrator's only credential.
ORCHESTRATOR_DATABASE_URL=
# Each agent's variables are set on this same service, and the orchestrator
# passes each agent only the names listed for it in config/schedule.yaml. Every
# name must start with that agent's prefix: RESEARCH_, OPPORTUNISTIC_IDENTIFIER_
# or PORTFOLIO_MANAGER_. Each agent's feature adds its own names here. Broker
# keys are never set on this service.

# --- Research (specs/007-research-agent, ADR 0015/0018) ---------------------
# Set on the orchestrator's service; the orchestrator passes Research only these.
# A login in the ta_research role.
RESEARCH_DATABASE_URL=
# A read-only Finnhub key. If it shares a Finnhub account with
# REFERENCE_DATA_FINNHUB_API_KEY, the two share that account's rate limit
# (specs/007-research-agent research R3); keep config/research.yaml's
# finnhub_calls_per_minute low enough for both.
RESEARCH_FINNHUB_API_KEY=
# Needed when config/research.yaml has model.provider: qwen (the default).
# Each agent gets its own prefixed variable, even when the value is the same
# key (owner's choice). The owner uses a QwenCloud Token Plan key (sk-sp-...).
RESEARCH_DASHSCOPE_API_KEY=
# Qwen's OpenAI-compatible base URL, matching the key's type: a Token Plan key
# and a pay-as-you-go key each have their own endpoint and don't mix
# (https://docs.qwencloud.com/developer-guides/administration/api-keys).
# Must be https://. Kept out of the source on purpose.
RESEARCH_QWEN_BASE_URL=
# Needed only when model.provider: anthropic.
RESEARCH_ANTHROPIC_API_KEY=

# --- Portfolio Manager (specs/008-portfolio-manager, ADR 0015/0016/0018) ----
# All set on the orchestrator's service; the orchestrator passes the PM only these.
# A login in the ta_portfolio_manager role.
PORTFOLIO_MANAGER_DATABASE_URL=
# A read-only Finnhub key (quotes only). If it shares a Finnhub account with
# RESEARCH_FINNHUB_API_KEY or REFERENCE_DATA_FINNHUB_API_KEY, they share that
# account's rate limit; keep finnhub_calls_per_minute low enough for all.
PORTFOLIO_MANAGER_FINNHUB_API_KEY=
# Needed when config/portfolio_manager.yaml has model.provider: qwen (the default).
PORTFOLIO_MANAGER_DASHSCOPE_API_KEY=
# Qwen's OpenAI-compatible base URL; the URL matches the key's type. Must be https://.
PORTFOLIO_MANAGER_QWEN_BASE_URL=
# Needed only when model.provider: anthropic.
PORTFOLIO_MANAGER_ANTHROPIC_API_KEY=
